# Copy to .env; replace every placeholder. Never commit .env.
ANNO_DECISION_BASE_URL=https://decision.example.com
ANNO_DECISION_MODEL=your-decision-model
ANNO_DECISION_AUTH_TOKEN=replace-with-provider-key
ANNO_GENERATE_BASE_URL=https://generation.example.com
ANNO_GENERATE_MODEL=your-generation-model
ANNO_GENERATE_AUTH_TOKEN=replace-with-provider-key
# legacy or qwen_vllm, according to your generation provider's protocol
ANNO_GENERATE_PROFILE=qwen_vllm
ANNO_SERVER_TOKEN=replace-with-random-server-access-token
ANNO_QUOTA_HMAC_SECRET=replace-with-stable-random-secret
ANNO_SERVER_ANONYMOUS=0
ANNO_SERVER_CONCURRENCY=4
ANNO_SERVER_DAILY_LIMIT=1000
ANNO_SERVER_IP_DAILY_LIMIT=50
ANNO_SERVER_IP_MINUTE_LIMIT=5
# Comma-separated allowed browser origins; local Python needs no Origin header.
ANNO_SERVER_ORIGINS=https://annotations.example.com
