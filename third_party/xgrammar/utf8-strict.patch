+TEST(StrictUTF8, EveryScalarAndInvalidEncodings) {
+  auto result = RegexFSMBuilder::Build("[\\s\\S]");
+  ASSERT_TRUE(result.IsOk());
+  auto dfa_result = std::move(result).Unwrap().ToDFA();
+  ASSERT_TRUE(dfa_result.IsOk());
+  auto fsm = std::move(dfa_result).Unwrap();
+  for (uint32_t cp = 0; cp <= 0x10FFFF; ++cp) {
+    if (cp >= 0xD800 && cp <= 0xDFFF) continue;
+    auto bytes = CharToUTF8(cp);
+    ASSERT_TRUE(AcceptFSM(fsm, bytes)) << cp;
+    auto decoded = ParseNextUTF8(bytes.c_str());
+    ASSERT_EQ(decoded.first, cp);
+    ASSERT_EQ(decoded.second, bytes.size());
+  }
+  for (const auto& bytes : BadUTF8()) {
+    EXPECT_FALSE(AcceptFSM(fsm, bytes));
+    EXPECT_EQ(ParseNextUTF8(bytes.c_str()).first, CharHandlingError::kInvalidUTF8);
+  }
+}
+TEST(StrictUTF8, EarleyWithoutFSMAndRollback) {
+  for (const auto& text : {"root ::= [^a]", "root ::= [^a]*", "root ::= [\\u0080-\\U0010ffff]"}) {
+    auto g = Grammar::FromEBNF(text);
+    g->optimized = true;
+    g->per_rule_fsms.resize(g->NumRules());
+    // Force the scalar character-class parser, independently of FSM optimization.
+    for (auto& fsm : g->per_rule_fsms) fsm.reset();
+    const auto& choices = g->GetGrammarExpr(g->GetRootRule().body_expr_id);
+    int seq = choices[0];
+    for (int i = 0; i < choices.size(); ++i) {
+      if (g->GetGrammarExpr(choices[i]).size() > 0) {seq = choices[i];break;}
+    }
+    ParserState initial(-1, seq, 0, ParserState::kNoPrevInputPos);
+    for (const auto& bytes : BadUTF8()) {
+      EarleyParser parser(g, initial);bool accepted = true;
+      for (uint8_t b : bytes) if (!parser.Advance(b)) {accepted = false;break;}
+      EXPECT_FALSE(accepted && parser.IsCompleted());
+    }
+    for (uint32_t cp : {0x80U,0x7FFU,0x800U,0xD7FFU,0xE000U,0xFFFFU,0x10000U,0x10FFFFU,0xFFFDU}) {
+      auto bytes = CharToUTF8(cp);EarleyParser parser(g, initial);
+      for (uint8_t b : bytes) ASSERT_TRUE(parser.Advance(b));
+      ASSERT_TRUE(parser.IsCompleted());
+      parser.PopLastStates(1);ASSERT_FALSE(parser.IsCompleted());
+      ASSERT_TRUE(parser.Advance(static_cast<uint8_t>(bytes.back())));
+      ASSERT_TRUE(parser.IsCompleted());
+    }
+    EarleyParser p(g, initial);ASSERT_TRUE(p.Advance(0xE0));EXPECT_FALSE(p.Advance(0x80));
+    ASSERT_TRUE(p.Advance(0xA0));ASSERT_TRUE(p.Advance(0x80));ASSERT_TRUE(p.IsCompleted());
+  }
+}
